{
  "version": 1,
  "frozen_on": "2026-11-01",
  "kind": "independent_synthetic_reusable_fact_cases",
  "policy": "在未读取本轮新生产实现的情况下编写。全部人物、关系、活动及日期均为合成回归材料，不是用户事实或产品词库。不得依据案例给生产代码增加关系名单、活动名单或固定回答。各案例分别创建独立存档；更正后清空聊天历史并重启，遗忘后即时查询及再次空历史重启查询。更正、持久化、检索交付、回答和遗忘分别判定。",
  "cases": [
    {
      "id": "roommate_name_ordinary",
      "seed": [
        {"mode": "explicit", "text": "我的名字是程言。"},
        {"mode": "chat", "text": "我的室友叫沈禾。"}
      ],
      "correction": "刚才我写错了，我的室友叫沈遥。",
      "query": "我的室友叫什么名字？",
      "forget": "请忘记我的室友。",
      "expected": {
        "subject": "室友",
        "field": "name",
        "old_literal": "沈禾",
        "new_literal": "沈遥",
        "old_values": ["沈禾"],
        "new_values": ["沈遥"],
        "preserved": ["程言"],
        "retained_literals": ["程言"],
        "identity_must_not_be": ["沈禾", "沈遥"],
        "after_forget_absent": ["沈禾", "沈遥"]
      },
      "rubric": "普通聊天原事实应受控保存；明确更正只更新室友名字，不能变成用户名字。空历史重启的有效事实和真实请求含室友关系及沈遥，不含沈禾，回答新名。遗忘后两次真实请求和回答均无旧新名，不追问索回；用户程言仍保存。"
    },
    {
