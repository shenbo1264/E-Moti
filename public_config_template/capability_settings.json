{
  "screen_observation": {
    "enabled": true,
    "auto_enabled": true,
    "interval_seconds": 120,
    "max_screenshot_width": 960,
    "send_screenshot_to_vision": true,
    "vision_provider": "openai_compatible",
    "vision_model": "mimo-v2.5",
    "vision_base_url": "https://token-plan-cn.xiaomimimo.com/v1",
    "vision_api_key": "",
    "timeout_seconds": 45
  },
  "web_search": {
    "enabled": true,
    "engine": "duckduckgo",
    "max_results": 3,
    "timeout_seconds": 12,
    "show_sources": true
  },
  "tts": {
    "enabled": false,
    "provider": "http_emoti_voice",
    "api_url": "http://127.0.0.1:9880/",
    "language": "zh",
    "auto_speak": false
  },
  "asr": {
    "enabled": false,
    "provider": "sensevoice_openai",
    "model": "sensevoice",
    "base_url": "http://127.0.0.1:8899/v1",
    "api_key": "",
    "language": "zh",
    "auto_send": false,
    "hotkey_enabled": false,
    "hotkey_sequence": "Ctrl+Alt+M",
    "max_record_seconds": 12
  },
  "proactive_companion": {
    "enabled": true,
    "interval_seconds": 900,
    "global_cooldown_seconds": 1800,
    "daily_limit": 6,
    "quiet_hours_enabled": true,
    "quiet_start": "23:00",
    "quiet_end": "08:00",
    "allow_context_topic": true
  }
}